# Copy this to server/.env for local testing only (never commit a real .env — .gitignore already
# excludes it). On Render, set each of these in the dashboard's Environment tab instead of a file.

# Shared team password — anyone with this password can use the app. Pick something you and your
# friend can remember but a stranger can't guess.
APP_PASSWORD=

# Random long string used to sign the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Your Anthropic API key, scoped to the "FIMS Factory App" workspace with the $10 spend limit.
# Starts with sk-ant-
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5 if not set.
ANTHROPIC_MODEL=claude-sonnet-5

# The ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# The full contents of your service account's downloaded JSON key file, as one line.
# If your hosting UI mangles multi-line JSON, use GOOGLE_SERVICE_ACCOUNT_JSON_BASE64 instead (see README).
GOOGLE_SERVICE_ACCOUNT_JSON=
